# Global Configs 全局配置
config defaultToCurrentScreen true       # 窗口操作默认作用于当前焦点所在屏幕
config windowHintsShowIcons true         # 窗口提示(Hints)中显示 App 图标
config windowHintsIgnoreHiddenWindows false  # 不忽略隐藏窗口，隐藏窗口也显示提示
config windowHintsSpread true            # 提示标签自动散开，避免相互重叠

# Show a positioning grid for each monitor
# bind g:cmd grid padding:5 0:2,2 1:2,1       #将第一个窗口分成4份，第二分成两份

# Monitor Aliases 显示器别名
# 用「分辨率」而不是「序号」来指定屏幕：插拔顺序变了也不会错位
alias mon-laptop  1728x1117      # 内建 Liquid Retina XDR（主屏，menubar 所在）
alias mon-wide    1920x1080      # HP Z27k G3   横屏 4K（UI 缩放后 1920x1080）
alias mon-tall    1080x1920      # HP Z27       竖屏（UI 缩放后 1080x1920）

# General aliases
alias hyper cmd;shift            # 组合键：定义 hyper = ⌘+⇧，供下方大量绑定复用
alias sox screenOriginX          # 屏幕原点X坐标缩写
alias soy screenOriginY          # 屏幕原点Y坐标缩写
alias ssx screenSizeX            # 屏幕宽度缩写
alias ssy screenSizeY            # 屏幕高度缩写

# Abstract positions  相对位置
alias centered           ${sox}+${ssx}/8;${soy}+${ssy}/8 ${ssx}/8*6;${ssy}/8*6   # 居中，四周各留1/8边距，占屏6/8
alias fullscreen         ${sox};${soy} ${ssx};${ssy}                             # 满屏
alias leftHalf           ${sox};${soy} ${ssx}/2;${ssy}                           # 左半屏
alias bottomHalf         ${sox};${soy}+${ssy}/2 ${ssx};${ssy}/2                  # 下半屏
alias topHalf            ${sox};${soy} ${ssx};${ssy}/2                           # 上半屏
alias rightHalf          ${sox}+${ssx}/2;${soy} ${ssx}/2;${ssy}                  # 右半屏
alias topLeftQuarter     ${sox};${soy} ${ssx}/2;${ssy}/2                         # 左上1/4
alias topRightQuarter    ${sox}+${ssx}/2;${soy} ${ssx}/2;${ssy}/2               # 右上1/4
alias bottomLeftQuarter  ${sox};${soy}+${ssy}/2 ${ssx}/2;${ssy}/2               # 左下1/4
alias bottomRightQuarter ${sox}+${ssx}/2;${soy}+${ssy}/2 ${ssx}/2;${ssy}/2      # 右下1/4
alias topThird           ${sox};${soy} ${ssx};${ssy}/3                           # 上1/3
alias leftThird          ${sox};${soy} ${ssx}/3;${ssy}                           # 左1/3
alias bottomThird        ${sox};${soy}+${ssy}/3 ${ssx};${ssy}/3                  # 下1/3
alias rightThird         ${sox}+${ssx}/3*2;${soy} ${ssx}/3;${ssy}               # 右1/3

