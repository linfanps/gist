# Bindings 模拟 Vim 控制窗口位置
bind g:${hyper} move ${centered}            # ⌘⇧+g 窗口居中
bind o:${hyper} move ${fullscreen}          # ⌘⇧+o 窗口全屏
bind h:${hyper} move ${leftHalf}            # ⌘⇧+h 移到左半屏(Vim左)
bind j:${hyper} move ${bottomHalf}          # ⌘⇧+j 移到下半屏(Vim下)
bind k:${hyper} move ${topHalf}             # ⌘⇧+k 移到上半屏(Vim上)
bind l:${hyper} move ${rightHalf}           # ⌘⇧+l 移到右半屏(Vim右)
bind u:${hyper} move ${topLeftQuarter}      # ⌘⇧+u 移到左上1/4
bind i:${hyper} move ${topRightQuarter}     # ⌘⇧+i 移到右上1/4
bind n:${hyper} move ${bottomLeftQuarter}   # ⌘⇧+n 移到左下1/4
bind m:${hyper} move ${bottomRightQuarter}  # ⌘⇧+m 移到右下1/4
bind y:${hyper} move ${leftThird}           # ⌘⇧+y 移到左1/3
bind p:${hyper} move ${rightThird}          # ⌘⇧+p 移到右下1/3


# Nudge Bindings
bind right:shift;alt        nudge +10% +0   # ⇧⌥+→ 窗口整体右移10%（不改大小）
bind left:shift;alt         nudge -10% +0   # ⇧⌥+← 窗口整体左移10%
bind up:shift;alt           nudge +0   -10% # ⇧⌥+↑ 窗口整体上移10%
bind down:shift;alt         nudge +0   +10% # ⇧⌥+↓ 窗口整体下移10%

# Throw Bindings
# bind [:${hyper} throw 0 resize:${ssx};${ssy}  # ⌘⇧+[ 把窗口丢到0号显示器并铺满
# bind ]:${hyper} throw 1 resize:${ssx};${ssy}  # ⌘⇧+] 把窗口丢到1号显示器并铺满


# relaunch .slate
bind s:${hyper} relaunch                    # ⌘⇧+s 重新加载 .slate 配置（改完用它生效）
# undo
bind z:${hyper} undo                        # ⌘⇧+z 撤销上一次窗口操作

# Focus Bindings
bind right:${hyper}    focus right          # ⌘⇧+→ 焦点切到右侧窗口（覆盖上方 resize）
bind left:${hyper}     focus left           # ⌘⇧+← 焦点切到左侧窗口（覆盖上方 resize）
bind up:${hyper}       focus up             # ⌘⇧+↑ 焦点切到上方窗口（覆盖上方 resize）
bind down:${hyper}     focus down           # ⌘⇧+↓ 焦点切到下方窗口（覆盖上方 resize）

