# App bindings
alias hyperApp cmd;ctrl                        # 组合键：定义 hyperApp = ⌘+⌃，用于切换 App
bind 0:${hyperApp} focus 'Ghostty'          # ⌘⌃+0 聚焦 Ghostty 终端
bind 2:${hyperApp} focus 'Paseo'           # ⌘⌃+8 聚焦 QQ音乐
bind 1:${hyperApp} focus 'Google Chrome'    # ⌘⌃+1 聚焦 Chrome 浏览器
bind 3:${hyperApp} focus 'Feishu'           # ⌘⌃+3 聚焦飞书 Feishu
bind 8:${hyperApp} focus 'Telegram'         # ⌘⌃+2 聚焦 Telegram
bind 9:${hyperApp} focus 'Code'             # ⌘⌃+9 聚焦 VS Code（注意：应用名是 Code，不是 Visual Studio Code）
